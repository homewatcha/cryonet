load std.strings: slice

static B64_CHARS: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

public fun base64_encode(data: bytes) -> string {
    set len = data.len()
    if len == 0 { return "" }
    set res = ""
    set i: int64 = 0

    while i + 2 < len {
        set b0: uint32 = cast(cast(data[i], "uint8"), "uint32")
        set b1: uint32 = cast(cast(data[i + 1], "uint8"), "uint32")
        set b2: uint32 = cast(cast(data[i + 2], "uint8"), "uint32")
        set triple: uint32 = (b0 << 16) | (b1 << 8) | b2

        set c0: int64 = cast((triple >> 18) & 63u32, "int64")
        set c1: int64 = cast((triple >> 12) & 63u32, "int64")
        set c2: int64 = cast((triple >> 6) & 63u32, "int64")
        set c3: int64 = cast(triple & 63u32, "int64")

        rewrite res = "${res}${slice(B64_CHARS, c0, c0 + 1)}${slice(B64_CHARS, c1, c1 + 1)}${slice(B64_CHARS, c2, c2 + 1)}${slice(B64_CHARS, c3, c3 + 1)}"
        rewrite i += 3
    }

    set rem = len - i
    if rem == 1 {
        set b0: uint32 = cast(cast(data[i], "uint8"), "uint32")
        set triple: uint32 = b0 << 16
        set c0: int64 = cast((triple >> 18) & 63u32, "int64")
        set c1: int64 = cast((triple >> 12) & 63u32, "int64")
        rewrite res = "${res}${slice(B64_CHARS, c0, c0 + 1)}${slice(B64_CHARS, c1, c1 + 1)}=="
    } else {
        if rem == 2 {
            set b0: uint32 = cast(cast(data[i], "uint8"), "uint32")
            set b1: uint32 = cast(cast(data[i + 1], "uint8"), "uint32")
            set triple: uint32 = (b0 << 16) | (b1 << 8)
            set c0: int64 = cast((triple >> 18) & 63u32, "int64")
            set c1: int64 = cast((triple >> 12) & 63u32, "int64")
            set c2: int64 = cast((triple >> 6) & 63u32, "int64")
            rewrite res = "${res}${slice(B64_CHARS, c0, c0 + 1)}${slice(B64_CHARS, c1, c1 + 1)}${slice(B64_CHARS, c2, c2 + 1)}="
        }
    }

    return res
}

fun b64_val(c: uint8) -> int32 {
    if c >= 65u8 && c <= 90u8 { return cast(c - 65u8, "int32") }
    if c >= 97u8 && c <= 122u8 { return cast(c - 97u8 + 26u8, "int32") }
    if c >= 48u8 && c <= 57u8 { return cast(c - 48u8 + 52u8, "int32") }
    if c == 43u8 { return 62 }
    if c == 47u8 { return 63 }
    return -1
}

public fun base64_decode(input: string) -> bytes? {
    set clean_bytes: uint8[] = []
    for i in 0..input.len() {
        set ch: uint8 = input[i]
        if ch != 61u8 && ch != 32u8 && ch != 13u8 && ch != 10u8 && ch != 9u8 {
            clean_bytes.push(ch)
        }
    }
    set len = clean_bytes.len()
    if len == 0 { return cast("", "bytes") }

    set out_bytes: uint8[] = []
    set i: int64 = 0
    while i + 3 < len {
        set v0 = b64_val(clean_bytes[i])
        set v1 = b64_val(clean_bytes[i + 1])
        set v2 = b64_val(clean_bytes[i + 2])
        set v3 = b64_val(clean_bytes[i + 3])
        if v0 < 0 || v1 < 0 || v2 < 0 || v3 < 0 { return null }

        set triple: uint32 = (cast(v0, "uint32") << 18) |
                             (cast(v1, "uint32") << 12) |
                             (cast(v2, "uint32") << 6) |
                             cast(v3, "uint32")

        out_bytes.push(cast((triple >> 16) & 0xFFu32, "uint8"))
        out_bytes.push(cast((triple >> 8) & 0xFFu32, "uint8"))
        out_bytes.push(cast(triple & 0xFFu32, "uint8"))
        rewrite i += 4
    }

    set rem = len - i
    if rem == 2 {
        set v0 = b64_val(clean_bytes[i])
        set v1 = b64_val(clean_bytes[i + 1])
        if v0 < 0 || v1 < 0 { return null }
        set triple: uint32 = (cast(v0, "uint32") << 18) | (cast(v1, "uint32") << 12)
        out_bytes.push(cast((triple >> 16) & 0xFFu32, "uint8"))
    } else {
        if rem == 3 {
            set v0 = b64_val(clean_bytes[i])
            set v1 = b64_val(clean_bytes[i + 1])
            set v2 = b64_val(clean_bytes[i + 2])
            if v0 < 0 || v1 < 0 || v2 < 0 { return null }
            set triple: uint32 = (cast(v0, "uint32") << 18) |
                                 (cast(v1, "uint32") << 12) |
                                 (cast(v2, "uint32") << 6)
            out_bytes.push(cast((triple >> 16) & 0xFFu32, "uint8"))
            out_bytes.push(cast((triple >> 8) & 0xFFu32, "uint8"))
        }
    }

    set s = ""
    for b_idx in 0..out_bytes.len() {
        set ch = cast(out_bytes[b_idx], "char")
        rewrite s = "${s}${ch}"
    }
    return cast(s, "bytes")
}

fun rotl32(v: uint32, n: uint32) -> uint32 {
    return ((v << n) | (v >> (32u32 - n))) & 0xFFFFFFFFu32
}

public fun sha1(input_str: string) -> bytes {
    set input: bytes = cast(input_str, "bytes")
    set bit_len: uint64 = cast(input.len(), "uint64") * 8u64

    set padded: uint8[] = []
    for i in 0..input.len() {
        padded.push(cast(input[i], "uint8"))
    }
    padded.push(0x80u8)

    while padded.len() % 64 != 56 {
        padded.push(0u8)
    }

    for b in 0..8 {
        set shift: uint64 = cast(56 - (b * 8), "uint64")
        set byte_val: uint8 = cast((bit_len >> shift) & 0xFFu64, "uint8")
        padded.push(byte_val)
    }

    set h0: uint32 = 0x67452301u32
    set h1: uint32 = 0xEFCDAB89u32
    set h2: uint32 = 0x98BADCFEu32
    set h3: uint32 = 0x10325476u32
    set h4: uint32 = 0xC3D2E1F0u32

    set total_chunks = padded.len() / 64
    for chunk_idx in 0..total_chunks {
        set base_offset = chunk_idx * 64
        set w: uint32[] = []

        for t in 0..16 {
            set off = base_offset + (t * 4)
            set word: uint32 = (cast(padded[off], "uint32") << 24) |
                               (cast(padded[off + 1], "uint32") << 16) |
                               (cast(padded[off + 2], "uint32") << 8) |
                               cast(padded[off + 3], "uint32")
            w.push(word)
        }

        for t in 16..80 {
            set s: uint32 = w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16]
            w.push(rotl32(s, 1u32))
        }

        set a = h0
        set b = h1
        set c = h2
        set d = h3
        set e = h4

        for t in 0..80 {
            set f: uint32 = 0u32
            set k: uint32 = 0u32
            if t < 20 {
                rewrite f = (b & c) | ((~b) & d)
                rewrite k = 0x5A827999u32
            } else {
                if t < 40 {
                    rewrite f = b ^ c ^ d
                    rewrite k = 0x6ED9EBA1u32
                } else {
                    if t < 60 {
                        rewrite f = (b & c) | (b & d) | (c & d)
                        rewrite k = 0x8F1BBCDCu32
                    } else {
                        rewrite f = b ^ c ^ d
                        rewrite k = 0xCA62C1D6u32
                    }
                }
            }

            set temp = (rotl32(a, 5u32) + f + e + k + w[t]) & 0xFFFFFFFFu32
            rewrite e = d
            rewrite d = c
            rewrite c = rotl32(b, 30u32)
            rewrite b = a
            rewrite a = temp
        }

        rewrite h0 = (h0 + a) & 0xFFFFFFFFu32
        rewrite h1 = (h1 + b) & 0xFFFFFFFFu32
        rewrite h2 = (h2 + c) & 0xFFFFFFFFu32
        rewrite h3 = (h3 + d) & 0xFFFFFFFFu32
        rewrite h4 = (h4 + e) & 0xFFFFFFFFu32
    }

    set out_bytes: uint8[] = []
    set words: uint32[] = [h0, h1, h2, h3, h4]
    for w_i in 0..5 {
        set val = words[w_i]
        out_bytes.push(cast((val >> 24) & 0xFFu32, "uint8"))
        out_bytes.push(cast((val >> 16) & 0xFFu32, "uint8"))
        out_bytes.push(cast((val >> 8) & 0xFFu32, "uint8"))
        out_bytes.push(cast(val & 0xFFu32, "uint8"))
    }

    set out_raw: bytes = from_raw_parts(out_bytes.as_ptr(), 20, 20)
    return out_raw
}
