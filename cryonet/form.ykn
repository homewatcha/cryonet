load core.mem: from_raw_parts
load core.utils: cast
load std.strings: split, trim, index_of, slice
load std.numf: parse_base

public struct FormEntry {
    key: string
    value: string
}

fun hex_digit(c: uint8) -> int32 {
    if c >= 48 && c <= 57 { return cast(c - 48, "int32") }
    if c >= 65 && c <= 70 { return cast(c - 55, "int32") }
    if c >= 97 && c <= 102 { return cast(c - 87, "int32") }
    return -1
}

public fun url_decode(s: string) -> string {
    set out_bytes: uint8[] = []
    set i: int64 = 0
    set n = s.len()
    while i < n {
        set c: uint8 = cast(s[i], "uint8")
        if c == 43 { // '+'
            out_bytes.push(32u8)
            rewrite i += 1
        } else {
            if c == 37 && i + 2 < n { // '%'
                set d1 = hex_digit(cast(s[i + 1], "uint8"))
                set d2 = hex_digit(cast(s[i + 2], "uint8"))
                if d1 >= 0 && d2 >= 0 {
                    set byte_val: uint8 = cast((d1 * 16) + d2, "uint8")
                    out_bytes.push(byte_val)
                    rewrite i += 3
                    continue
                }
            }
            out_bytes.push(c)
            rewrite i += 1
        }
    }
    return cast(from_raw_parts(out_bytes.as_ptr(), out_bytes.len()), "string")
}

public class Form {
    entries: FormEntry[]

    public fun init(entries: FormEntry[] = []) {
        rewrite this.entries = entries
    }

    public fun get(key: string) -> string? {
        for i in 0..this.entries.len() {
            if this.entries[i].key == key {
                return this.entries[i].value
            }
        }
        return null
    }

    public fun get_all(key: string) -> string[] {
        set res: string[] = []
        for i in 0..this.entries.len() {
            if this.entries[i].key == key {
                res.push(this.entries[i].value)
            }
        }
        return res
    }

    public fun get_int(key: string) -> int32? {
        set val = this.get(key)
        if val == null { return null }
        set non_null = val ?? ""
        set parsed = parse_base(non_null, 10)
        if parsed == null { return null }
        return cast(parsed ?? 0, "int32")
    }

    public fun has(key: string) -> bool {
        return this.get(key) != null
    }

    public fun get_bool(key: string) -> bool? {
        set val = this.get(key)
        if val == null { return null }
        set s = val ?? ""
        if s == "true" || s == "1" || s == "on" || s == "yes" { return true }
        if s == "false" || s == "0" || s == "off" || s == "no" { return false }
        return null
    }

    public fun all() -> FormEntry[] {
        return this.entries
    }
}

public fun parse_form(raw: string) -> Form {
    set entries: FormEntry[] = []
    set pairs = split(raw, "&")
    for i in 0..pairs.len() {
        set p = trim(pairs[i])
        if p.len() == 0 { continue }
        set eq = index_of(p, "=")
        if eq != null {
            set eq_idx = eq ?? 0
            set k = url_decode(trim(slice(p, 0, eq_idx)))
            set v = url_decode(trim(slice(p, eq_idx + 1, p.len())))
            entries.push(FormEntry { key: k, value: v })
        } else {
            set k = url_decode(p)
            entries.push(FormEntry { key: k, value: "" })
        }
    }
    return init Form(entries)
}
